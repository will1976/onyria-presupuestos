# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/onyria_presupuestos

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Servidor
PORT=3001
NODE_ENV=development

# Frontend URL (para CORS)
CLIENT_URL=http://localhost:5173

# Configuración de la empresa (se puede sobreescribir desde la BD)
COMPANY_NAME=Onyria Studio
COMPANY_EMAIL=contacto@onyria.cl
COMPANY_PHONE=+56 2 2345 6789
COMPANY_ADDRESS=Santiago, Chile
