{{!--
  Template Handlebars de cotización A4.
  Layout: flow layout, sin position:absolute.

  Header (header.png con N° y fecha): repetido en CADA página vía
  Puppeteer headerTemplate.

  Bottom (Observaciones + Forma de Pago + Condiciones + Empresa + footer.png):
  repetido en CADA página vía Puppeteer footerTemplate.

  Body (este template): cliente + proyecto + detalle + TOTALES.
  Los Totales son lo último del body, así que naturalmente quedan
  SÓLO en la última página, al final del detalle.

  Variables esperadas (ver pdf-generator.js → buildContext()):
    numeroCotizacion, fechaCotizacion, cliente, proyecto, contactoCliente,
    mailCliente, ejecutivo, mailEjecutivo, items[{descripcion}],
    neto, iva, total
--}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Cotización {{numeroCotizacion}}</title>
  <style>
    /* ── Reset ────────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif; color: #1F5773; font-size: 10pt; }

    /* ── A4: márgenes horizontales en 0 para que header.png/footer.png
       lleguen al borde. El padding horizontal del contenido se aplica via
       body abajo. top=36mm reserva espacio para header.png + N°/fecha.
       bottom=95mm reserva espacio para todo el bloque footer (observaciones,
       forma de pago, condiciones, empresa, footer.png). */
    @page {
      size: A4;
      margin: 36mm 0 95mm 0;
    }

    body { padding: 0 18mm; }

    /* ── Datos cliente / ejecutivo / proyecto ─────────────────────── */
    .meta-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 8mm;
      margin-bottom: 6mm;
    }
    .meta-grid .field { line-height: 1.25; }
    .meta-grid .field-label { color: #1F5773; }
    .meta-grid .field-value { color: #0E2A38; font-weight: 700; }

    /* ── Proyecto ─────────────────────────────────────────────────── */
    .proyecto {
      margin-top: 4mm;
      padding-bottom: 2mm;
      border-bottom: 4px solid #0E4561;
    }
    .proyecto .p-name { font-weight: 700; color: #0E2A38; font-size: 11pt; }

    /* ── Detalle ──────────────────────────────────────────────────── */
    .section-title {
      font-weight: 700;
      color: #0E2A38;
      text-decoration: underline;
      margin: 6mm 0 3mm;
      font-size: 10pt;
    }

    .detalle ul { list-style: disc; padding-left: 5mm; line-height: 1.4; font-size: 8pt; }
    .detalle ul li { padding-left: 1mm; page-break-inside: avoid; }
    .detalle ul ul { list-style: circle; padding-left: 6mm; margin: 0.4mm 0 0.8mm; line-height: 1.3; font-size: 7.5pt; }

    /* ── Totales ──────────────────────────────────────────────────── */
    .totales-wrap {
      display: flex;
      justify-content: flex-end;
      margin-top: 12mm;
      page-break-inside: avoid;
    }
    .totales {
      min-width: 70mm;
      text-align: right;
      font-weight: 700;
      color: #0E2A38;
      font-size: 10pt;
      line-height: 1.9;
    }

    /* ── Utilidades de impresión ──────────────────────────────────── */
    .avoid-break { page-break-inside: avoid; }
    .force-break { page-break-before: always; }
  </style>
</head>
<body>

  {{!-- Cabecera de datos cliente. El N° y la fecha van en el header.png como overlay. --}}
  <div class="meta-grid">
    <div>
      <div class="field"><span class="field-label">Para:</span> <span class="field-value">{{contactoCliente}}</span></div>
      <div class="field"><span class="field-label">Cliente:</span> <span class="field-value">{{cliente}}</span></div>
      <div class="field"><span class="field-label">Mail:</span> <span class="field-value">{{mailCliente}}</span></div>
      <div class="field"><span class="field-label">De:</span> <span class="field-value">{{ejecutivo}}</span></div>
      <div class="field"><span class="field-label">Mail:</span> <span class="field-value">{{mailEjecutivo}}</span></div>
    </div>
    <div></div>
  </div>

  {{!-- Proyecto --}}
  <div class="proyecto">
    <span class="field-label">Proyecto:</span> <span class="p-name">{{proyecto}}</span>
  </div>

  {{!-- Detalle --}}
  <div class="detalle">
    <div class="section-title">Detalle:</div>
    <ul>
      {{#each items}}
        <li>
          {{#if this.cantidad}}{{this.cantidad}} {{/if}}{{this.descripcion}}
          {{#if this.subBullets.length}}
            <ul>
              {{#each this.subBullets}}<li>{{this}}</li>{{/each}}
            </ul>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  </div>

  {{!-- Totales (al final del body → sólo se ven en la última página) --}}
  <div class="totales-wrap">
    <div class="totales">
      <div>Total Neto: $ {{neto}}</div>
      <div>IVA (19%): $ {{iva}}</div>
      <div class="tot-final">TOTAL: $ {{total}}</div>
    </div>
  </div>

</body>
</html>
