{{!--
  Template Handlebars de cotización A4.
  Layout: flow layout, sin position:absolute. El contenido crece dinámicamente
  y, si pasa una página, Puppeteer paginará automáticamente; el header.png y
  footer.png se repiten en cada página vía displayHeaderFooter del PDF.

  Variables esperadas (ver pdf-generator.js → buildContext()):
    numeroCotizacion, fechaCotizacion, cliente, proyecto, contactoCliente,
    mailCliente, ejecutivo, mailEjecutivo, items[{descripcion}],
    neto, iva, total, observaciones[], condiciones, formaPago, moneda
--}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Cotización {{numeroCotizacion}}</title>
  <style>
    /* ── Reset ────────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif; color: #1F5773; font-size: 10pt; }

    /* ── A4: tamaño de página y márgenes para header/footer fijos ───
       Márgenes horizontales en 0 para que header.png/footer.png lleguen al
       borde. El padding horizontal del contenido se aplica via body abajo. */
    @page {
      size: A4;
      margin: 36mm 0 32mm 0;
    }

    /* Padding horizontal del contenido (lo que antes hacía @page margin-left/right) */
    body { padding: 0 18mm; }

    /* ── Tipografía y colores ─────────────────────────────────────── */
    .strong       { color: #0E2A38; font-weight: 700; }
    .muted        { color: #5F7C8B; }
    .row          { display: flex; }

    /* ── Datos cliente / ejecutivo / proyecto ─────────────────────── */
    .meta-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 8mm;
      margin-bottom: 6mm;
    }
    .meta-grid .field { line-height: 1.25; }
    .meta-grid .field-label { color: #1F5773; }
    .meta-grid .field-value { color: #0E2A38; font-weight: 700; }

    .num-box { text-align: right; }
    .num-box .num-lbl   { font-size: 9pt; color: #5F7C8B; }
    .num-box .num-val   { font-size: 13pt; font-weight: 700; color: #0E2A38; letter-spacing: 0.5px; }
    .num-box .num-fecha { font-size: 9pt; color: #5F7C8B; margin-top: 2px; }

    /* ── Proyecto ─────────────────────────────────────────────────── */
    .proyecto {
      margin-top: 4mm;
      padding-bottom: 2mm;
      border-bottom: 4px solid #0E4561;
    }
    .proyecto .p-name { font-weight: 700; color: #0E2A38; font-size: 11pt; }

    /* ── Detalle ──────────────────────────────────────────────────── */
    .section-title {
      font-weight: 700;
      color: #0E2A38;
      text-decoration: underline;
      margin: 6mm 0 3mm;
      font-size: 10pt;
    }

    .detalle ul { list-style: disc; padding-left: 5mm; line-height: 1.55; font-size: 8.5pt; }
    .detalle ul li { padding-left: 1mm; page-break-inside: avoid; }
    .detalle ul ul { list-style: circle; padding-left: 6mm; margin: 0.5mm 0 1mm; line-height: 1.4; font-size: 8pt; }

    /* ── Totales ──────────────────────────────────────────────────── */
    .totales-wrap {
      display: flex;
      justify-content: flex-end;
      margin-top: 8mm;
      page-break-inside: avoid;
    }
    .totales {
      min-width: 70mm;
      text-align: right;
      font-weight: 700;
      color: #0E2A38;
      line-height: 1.9;
    }
    .totales .tot-final { font-size: 12pt; }

    /* ── Observaciones ────────────────────────────────────────────── */
    .observaciones,
    .condiciones,
    .forma-pago {
      margin-top: 6mm;
      page-break-inside: avoid;
    }

    .section-bar {
      background: #0E4561;
      color: #FFFFFF;
      padding: 1.5mm 4mm;
      font-weight: 700;
      font-size: 8pt;
      letter-spacing: 0.3px;
      margin-bottom: 2mm;
    }

    .observaciones ul,
    .condiciones ul {
      list-style: disc;
      padding-left: 5mm;
      font-size: 7.5pt;
      line-height: 1.35;
      color: #0E2A38;
    }
    .observaciones ul li,
    .condiciones ul li {
      margin-bottom: 0.6mm;
      padding-left: 1mm;
    }

    .forma-pago .fp-text {
      font-size: 8pt;
      color: #0E2A38;
      padding: 0 1mm;
    }

    /* ── Bloque de datos de empresa (al pie del contenido) ─────────── */
    .empresa-info {
      margin-top: 6mm;
      page-break-inside: avoid;
      text-align: center;
      color: #0E2A38;
    }
    .empresa-info .emp-bar {
      height: 3mm;
      background: #0E4561;
      margin: 0;
    }
    .empresa-info .emp-block {
      padding: 2mm 0;
      font-size: 8pt;
      line-height: 1.35;
    }
    .empresa-info .emp-block .emp-name { font-weight: 700; font-size: 8.5pt; }

    /* ── Utilidades de impresión ──────────────────────────────────── */
    .avoid-break { page-break-inside: avoid; }
    .force-break { page-break-before: always; }
  </style>
</head>
<body>

  {{!-- Cabecera de datos (cliente + número de cotización) --}}
  <div class="meta-grid">
    <div>
      <div class="field"><span class="field-label">Para:</span> <span class="field-value">{{contactoCliente}}</span></div>
      <div class="field"><span class="field-label">Cliente:</span> <span class="field-value">{{cliente}}</span></div>
      <div class="field"><span class="field-label">Mail:</span> <span class="field-value">{{mailCliente}}</span></div>
      <div class="field"><span class="field-label">De:</span> <span class="field-value">{{ejecutivo}}</span></div>
      <div class="field"><span class="field-label">Mail:</span> <span class="field-value">{{mailEjecutivo}}</span></div>
    </div>
    <div class="num-box">
      <div class="num-lbl">N° Cotización</div>
      <div class="num-val">{{numeroCotizacion}}</div>
      <div class="num-fecha">{{fechaCotizacion}}</div>
      {{#if validez}}<div class="num-fecha">Validez: {{validez}} días</div>{{/if}}
    </div>
  </div>

  {{!-- Proyecto --}}
  <div class="proyecto">
    <span class="field-label">Proyecto:</span> <span class="p-name">{{proyecto}}</span>
  </div>

  {{!-- Detalle --}}
  <div class="detalle">
    <div class="section-title">Detalle:</div>
    <ul>
      {{#each items}}
        <li>
          {{#if this.cantidad}}{{this.cantidad}} {{/if}}{{this.descripcion}}
          {{#if this.subBullets.length}}
            <ul>
              {{#each this.subBullets}}<li>{{this}}</li>{{/each}}
            </ul>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  </div>

  {{!-- Totales --}}
  <div class="totales-wrap">
    <div class="totales">
      <div>Total Neto: $ {{neto}}</div>
      <div>IVA (19%): $ {{iva}}</div>
      <div class="tot-final">TOTAL: $ {{total}}</div>
    </div>
  </div>

  {{!-- Observaciones --}}
  {{#if observaciones.length}}
  <div class="observaciones">
    <div class="section-bar">Observaciones</div>
    <ul>
      {{#each observaciones}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  {{!-- Forma de pago --}}
  {{#if formaPago}}
  <div class="forma-pago">
    <div class="section-bar">Forma de Pago: {{formaPago}}</div>
  </div>
  {{/if}}

  {{!-- Condiciones --}}
  {{#if condiciones.length}}
  <div class="condiciones">
    <ul>
      {{#each condiciones}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  {{!-- Bloque empresa (al pie, antes del footer.png) --}}
  {{#if empresa}}
  <div class="empresa-info">
    <div class="emp-bar"></div>
    <div class="emp-block">
      <div class="emp-name">{{empresa.nombre}}</div>
      {{#if empresa.rut}}<div>Rut: {{empresa.rut}}</div>{{/if}}
      {{#if empresa.direccion}}<div>Dirección: {{empresa.direccion}}</div>{{/if}}
    </div>
    <div class="emp-bar"></div>
    <div class="emp-block">
      {{#if empresa.banco}}<div>{{empresa.banco}}</div>{{/if}}
      {{#if empresa.correo}}<div>Correo: {{empresa.correo}}</div>{{/if}}
    </div>
  </div>
  {{/if}}

</body>
</html>
